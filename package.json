{
  "name": "discord-rp-bot",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @discord-rp/database exec prisma migrate dev",
    "db:deploy": "pnpm --filter @discord-rp/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @discord-rp/database run seed",
    "db:studio": "pnpm --filter @discord-rp/database exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "deepmerge-ts@<8.0.0": ">=8.0.0"
    }
  }
}
