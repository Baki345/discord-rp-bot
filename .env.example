# --- Postgres ---
POSTGRES_USER=discordrp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=discordrp
DATABASE_URL=postgresql://discordrp:change-me@localhost:5432/discordrp

# --- Discord Application (developer.discord.com/applications) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
# Used by apps/bot/src/deploy-commands.ts for fast per-guild registration during dev
DISCORD_DEV_GUILD_ID=

# --- Dashboard (Auth.js) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Global admin (comma-separated Discord user IDs) ---
SUPER_ADMIN_DISCORD_IDS=

# --- Ticket transcript signing (generate with openssl rand -base64 32) ---
TRANSCRIPT_SIGNING_SECRET=

# --- Production only ---
DASHBOARD_DOMAIN=
# Localhost port the dashboard container is published on, for a host-level
# reverse proxy (nginx, Caddy...) already terminating TLS on this machine
# to forward to. Pick one not already used by another site on the VPS.
DASHBOARD_LOCAL_PORT=3002
