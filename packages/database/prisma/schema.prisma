generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================= AUTH (Auth.js / NextAuth v5 Prisma adapter) =======================

model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  username      String
  discriminator String?
  globalName    String?
  avatarUrl     String?
  email         String?
  // Auth.js's PrismaAdapter reads/writes these three fields unconditionally
  // on every user (createUser, updateUser, ...) regardless of the custom
  // `profile()` mapping used above — required even though globalName/
  // avatarUrl are what the rest of the app actually reads.
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?
  scope             String?
  token_type        String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================= TENANCY / GUILD =============================

model Guild {
  id             String   @id // Discord guild snowflake, used as PK directly
  name           String
  iconUrl        String?
  ownerDiscordId String
  locale         String   @default("fr")
  currencyName   String   @default("Dollar")
  currencySymbol String   @default("$")
  isBlacklisted  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  planId       String             @default("FREE")
  plan         PremiumPlan        @relation(fields: [planId], references: [id])
  subscription GuildSubscription?
  config       GuildConfig?

  characters        Character[]
  items             Item[]
  jobs              Job[]
  companies         Company[]
  vehicleCategories VehicleCategory[]
  vehicleModels     VehicleModel[]
  vehicles          Vehicle[]
  places            Place[]
  shops             Shop[]
  rpRoles           RPRole[]
  auditLogs         AuditLog[]
  bankAccounts      BankAccount[]
  transactions      Transaction[]
  activityDefinitions ActivityDefinition[]
  craftingRecipes     CraftingRecipe[]
  licenses            License[]
  rpSessions          RPSession[]
  robberyTargets      RobberyTarget[]
  drugTypes           DrugType[]

  @@index([planId])
}

model GuildConfig {
  guildId                String   @id
  guild                  Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  hungerThirstEnabled    Boolean  @default(false)
  requireActiveSession   Boolean  @default(false)
  afkChannelId           String?
  afkTimeoutMinutes      Int      @default(20)
  startingCashCents      Int      @default(50000)
  maxCharactersOverride  Int?
  auditLogChannelId      String?
  economyLogChannelId    String?
  moderationLogChannelId String?
  quarantineRoleId       String?
  joinGateConfig         Json     @default("{}")
  joinRaidConfig         Json     @default("{}")
  verificationConfig     Json     @default("{}")
  automodConfig          Json     @default("{}")
  lockdownState          Json     @default("{}")
  antiNukeConfig         Json     @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PremiumPlan {
  id         String  @id // "FREE" | "PREMIUM" | "PREMIUM_PLUS"
  name       String
  priceCents Int     @default(0)
  isDefault  Boolean @default(false)

  maxCharactersPerGuild Int
  maxVehiclesPerGuild   Int
  maxCompaniesPerGuild  Int
  maxJobsPerGuild       Int
  maxShopsPerGuild      Int
  maxPlacesPerGuild     Int
  featureFlags          Json @default("{}")

  guilds    Guild[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuildSubscription {
  guildId            String             @id
  guild              Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  status             SubscriptionStatus @default(NONE)
  provider           String?
  externalCustomerId String?
  externalSubId      String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

// ============================= CHARACTER =============================

model Character {
  id            String @id @default(cuid())
  guildId       String
  guild         Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId String

  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  gender               String?
  nationality          String?
  avatarUrl            String?
  bio                  String?         @db.Text
  cashCents            Int             @default(0)
  status               CharacterStatus @default(ACTIVE)
  isActiveForUser      Boolean         @default(true)
  hunger               Int?
  thirst               Int?
  lastNeedsTickAt      DateTime?
  criminalRecordPoints Int             @default(0)
  jailedUntil          DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bankAccounts         BankAccount[]
  inventoryItems       InventoryItem[]
  jobMembership        CharacterJob?
  companyEmployment    CompanyEmployee[]
  ownedCompanies       Company[]         @relation("CompanyOwner")
  ownedVehicles        Vehicle[]         @relation("VehicleOwner")
  ownedPlaces          Place[]           @relation("PlaceOwner")
  rpRoles              CharacterRPRole[]
  sentTransactions     Transaction[]     @relation("TxFromCharacter")
  receivedTransactions Transaction[]     @relation("TxToCharacter")
  auditLogEntries      AuditLog[]        @relation("AuditActorCharacter")
  heldVehicleKeys      VehicleKey[]      @relation("VehicleKeyHolder")
  heldPlaceKeys        PlaceKey[]        @relation("PlaceKeyHolder")
  activityAttempts     ActivityAttempt[]
  licenses             CharacterLicense[]
  robberyAttempts      RobberyAttempt[]
  racketCollections    RacketCollection[]
  launderingOperations LaunderingOperation[]
  companyShares        CompanyShare[]

  @@unique([guildId, discordUserId, firstName, lastName])
  @@index([guildId, discordUserId])
  @@index([guildId])
}

enum CharacterStatus {
  ACTIVE
  JAILED
  HOSPITALIZED
  DEAD
  ARCHIVED
}

// ============================= ITEMS / INVENTORY =============================

model Item {
  id           String     @id @default(cuid())
  guildId      String
  guild        Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key          String
  name         String
  description  String?    @db.Text
  category     String
  rarity       ItemRarity @default(COMMON)
  weight       Float      @default(0)
  priceCents   Int        @default(0)
  isStackable  Boolean    @default(true)
  isUsable     Boolean    @default(false)
  isConsumable Boolean    @default(false)
  isIllegal    Boolean    @default(false)
  metadata     Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventoryItems InventoryItem[]
  shopProducts   ShopProduct[]
  craftingIngredientOf CraftingIngredient[]
  craftingResultOf     CraftingRecipe[] @relation("CraftingRecipeResult")
  drugTypes            DrugType[]

  @@unique([guildId, key])
  @@index([guildId])
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model InventoryItem {
  id          String    @id @default(cuid())
  guildId     String
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Int       @default(1)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, itemId])
  @@index([guildId])
  @@index([characterId])
}

// ============================= ECONOMY =============================

model BankAccount {
  id              String          @id @default(cuid())
  guildId         String
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characterId     String?
  character       Character?      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?        @relation("CompanyBankAccounts", fields: [companyId], references: [id], onDelete: Cascade)
  type            BankAccountType @default(PERSONAL)
  balanceCents    Int             @default(0)
  interestRateBps Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  outgoing          Transaction[] @relation("TxFromAccount")
  incoming          Transaction[] @relation("TxToAccount")
  treasuryOfCompany Company?      @relation("CompanyTreasuryAccount")

  @@index([guildId])
  @@index([characterId])
  @@index([companyId])
}

enum BankAccountType {
  PERSONAL
  COMPANY
  SAVINGS
}

model Transaction {
  id              String          @id @default(cuid())
  guildId         String
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type            TransactionType
  amountCents     Int
  fromAccountId   String?
  fromAccount     BankAccount?    @relation("TxFromAccount", fields: [fromAccountId], references: [id])
  toAccountId     String?
  toAccount       BankAccount?    @relation("TxToAccount", fields: [toAccountId], references: [id])
  fromCharacterId String?
  fromCharacter   Character?      @relation("TxFromCharacter", fields: [fromCharacterId], references: [id])
  toCharacterId   String?
  toCharacter     Character?      @relation("TxToCharacter", fields: [toCharacterId], references: [id])
  reason          String?
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())

  @@index([guildId, createdAt])
  @@index([fromAccountId])
  @@index([toAccountId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  TRANSFER_CASH
  TRANSFER_BANK
  SALARY
  FINE
  SHOP_PURCHASE
  SHOP_SALE
  VEHICLE_PURCHASE
  ADMIN_ADJUSTMENT
  LAUNDER
}

// ============================= JOBS =============================

model Job {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?  @db.Text
  logoUrl     String?
  isIllegal   Boolean  @default(false)
  isDefault   Boolean  @default(false)
  isLawEnforcement Boolean @default(false) // counts toward RobberyTarget.minPoliceOnDuty when a member is on duty
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grades  JobGrade[]
  members CharacterJob[]

  @@unique([guildId, key])
  @@index([guildId])
}

model JobGrade {
  id          String @id @default(cuid())
  jobId       String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  rank        Int
  salaryCents Int    @default(0)
  permissions Json   @default("[]")

  members CharacterJob[]

  @@unique([jobId, rank])
}

model CharacterJob {
  id          String    @id @default(cuid())
  guildId     String
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  gradeId     String
  grade       JobGrade  @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  hiredAt     DateTime  @default(now())
  onDuty      Boolean   @default(false)

  @@index([guildId])
  @@index([jobId])
}

// ============================= COMPANIES =============================

model Company {
  id                String       @id @default(cuid())
  guildId           String
  guild             Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name              String
  description       String?      @db.Text
  logoUrl           String?
  ownerCharacterId  String
  ownerCharacter    Character    @relation("CompanyOwner", fields: [ownerCharacterId], references: [id])
  treasuryAccountId String?      @unique
  treasuryAccount   BankAccount? @relation("CompanyTreasuryAccount", fields: [treasuryAccountId], references: [id])
  lastRacketedAt    DateTime?
  isLaunderingFront Boolean      @default(false)
  isPubliclyListed  Boolean      @default(false)
  totalShares       Int?
  sharePriceCents   Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  grades       CompanyGrade[]
  employees    CompanyEmployee[]
  bankAccounts BankAccount[]     @relation("CompanyBankAccounts")
  vehicles     Vehicle[]         @relation("CompanyVehicles")
  shop         Shop?
  places       Place[]           @relation("CompanyPlaces")
  racketCollections    RacketCollection[]
  launderingOperations LaunderingOperation[]
  shares               CompanyShare[]
  priceHistory         SharePriceHistory[]

  @@unique([guildId, name])
  @@index([guildId])
}

model CompanyGrade {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  rank        Int
  salaryCents Int     @default(0)
  permissions Json    @default("[]")

  employees CompanyEmployee[]

  @@unique([companyId, rank])
}

model CompanyEmployee {
  id          String       @id @default(cuid())
  guildId     String
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  characterId String
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  gradeId     String
  grade       CompanyGrade @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  hiredAt     DateTime     @default(now())

  @@unique([companyId, characterId])
  @@index([guildId])
}

// ============================= VEHICLES =============================

model VehicleCategory {
  id             String @id @default(cuid())
  guildId        String
  guild          Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key            String
  name           String
  basePriceCents Int    @default(0)

  models VehicleModel[]

  @@unique([guildId, key])
  @@index([guildId])
}

model VehicleModel {
  id         String          @id @default(cuid())
  guildId    String
  guild      Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  categoryId String
  category   VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  brand      String?
  priceCents Int             @default(0)
  maxSpeed   Int?
  seats      Int             @default(4)
  imageUrl   String?

  vehicles Vehicle[]

  @@unique([guildId, name])
  @@index([guildId])
}

model Vehicle {
  id               String        @id @default(cuid())
  guildId          String
  guild            Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  modelId          String
  model            VehicleModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  plate            String
  ownerCharacterId String?
  ownerCharacter   Character?    @relation("VehicleOwner", fields: [ownerCharacterId], references: [id])
  ownerCompanyId   String?
  ownerCompany     Company?      @relation("CompanyVehicles", fields: [ownerCompanyId], references: [id])
  condition        Int           @default(100)
  fuel             Int           @default(100)
  mileage          Int           @default(0)
  insuranceUntil   DateTime?
  status           VehicleStatus @default(GARAGED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  keys VehicleKey[]

  @@unique([guildId, plate])
  @@index([guildId])
  @@index([ownerCharacterId])
}

/** A spare key granted to someone other than the owner — distinct from ownership, which stays exclusive (only the owner can sell). */
model VehicleKey {
  id          String    @id @default(cuid())
  guildId     String
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation("VehicleKeyHolder", fields: [characterId], references: [id], onDelete: Cascade)
  grantedAt   DateTime  @default(now())

  @@unique([vehicleId, characterId])
  @@index([guildId])
}

enum VehicleStatus {
  GARAGED
  IMPOUNDED
  DESTROYED
  IN_USE
}

// ============================= PLACES / SHOPS =============================

model Place {
  id               String     @id @default(cuid())
  guildId          String
  guild            Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name             String
  description      String?    @db.Text
  imageUrl         String?
  category         String?
  coordX           Float?
  coordY           Float?
  coordZ           Float?
  ownerCharacterId String?
  ownerCharacter   Character? @relation("PlaceOwner", fields: [ownerCharacterId], references: [id])
  companyId        String?
  company          Company?   @relation("CompanyPlaces", fields: [companyId], references: [id])
  requiredLicenseKey String?  // optional gate, e.g. entering a restricted site (checked against CharacterLicense)
  discordChannelId String?    // optional: ties this Place to a channel — a "place-gated" action (activities, crafting, drugs...) run outside that channel is rejected. Unset = not enforced.
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  shops Shop[]
  keys  PlaceKey[]

  @@unique([guildId, name])
  @@index([guildId])
}

/** A spare key granted to someone other than the owner — distinct from ownership. */
model PlaceKey {
  id          String    @id @default(cuid())
  guildId     String
  placeId     String
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation("PlaceKeyHolder", fields: [characterId], references: [id], onDelete: Cascade)
  grantedAt   DateTime  @default(now())

  @@unique([placeId, characterId])
  @@index([guildId])
}

model Shop {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  logoUrl   String?
  placeId   String?
  place     Place?   @relation(fields: [placeId], references: [id])
  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id])
  openHour  Int?
  closeHour Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ShopProduct[]

  @@unique([guildId, name])
  @@index([guildId])
}

model ShopProduct {
  id         String  @id @default(cuid())
  shopId     String
  shop       Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceCents Int
  stock      Int?
  canBuy     Boolean @default(true)
  canSell    Boolean @default(true)

  @@unique([shopId, itemId])
}

// ============================= PERMISSIONS (RPRole) =============================

model RPRole {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key           String
  name          String
  color         String?
  permissions   Json     @default("[]")
  discordRoleId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberAssignments    GuildMemberRPRole[]
  characterAssignments CharacterRPRole[]

  @@unique([guildId, key])
  @@index([guildId])
}

model GuildMemberRPRole {
  id            String   @id @default(cuid())
  guildId       String
  discordUserId String
  roleId        String
  role          RPRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt    DateTime @default(now())

  @@unique([guildId, discordUserId, roleId])
  @@index([guildId, discordUserId])
}

model CharacterRPRole {
  id          String    @id @default(cuid())
  guildId     String
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  roleId      String
  role        RPRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([characterId, roleId])
  @@index([guildId])
}

// ============================= ACTIVITIES =============================
// A generic cooldown+reward loop (fishing, mining, delivery runs, ...) —
// reused conceptually by later systems (drugs, robbery) which have their
// own richer models but the same attempt/cooldown/reward shape.

model ActivityDefinition {
  id                 String  @id @default(cuid())
  guildId            String
  guild              Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key                String
  name               String
  cooldownMinutes    Int     @default(30)
  rewardCashMinCents Int     @default(0)
  rewardCashMaxCents Int     @default(0)
  rewardItemId       String?
  rewardItemQty      Int     @default(1)
  requiredPlaceId    String?

  attempts ActivityAttempt[]

  @@unique([guildId, key])
  @@index([guildId])
}

model ActivityAttempt {
  id              String             @id @default(cuid())
  guildId         String
  activityId      String
  activity        ActivityDefinition @relation(fields: [activityId], references: [id], onDelete: Cascade)
  characterId     String
  character       Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  rewardCashCents Int
  createdAt       DateTime           @default(now())

  @@index([characterId, activityId])
}

// ============================= CRAFTING =============================

model CraftingRecipe {
  id              String  @id @default(cuid())
  guildId         String
  guild           Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key             String
  name            String
  resultItemId    String
  resultItem      Item    @relation("CraftingRecipeResult", fields: [resultItemId], references: [id], onDelete: Restrict)
  resultQuantity  Int     @default(1)
  requiredPlaceId String?

  ingredients CraftingIngredient[]

  @@unique([guildId, key])
  @@index([guildId])
}

model CraftingIngredient {
  id       String         @id @default(cuid())
  recipeId String
  recipe   CraftingRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Int            @default(1)
}

// ============================= LICENSES & EXAMS =============================

model License {
  id           String @id @default(cuid())
  guildId      String
  guild        Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key          String
  name         String
  passScorePct Int    @default(80)

  questions        LicenseQuestion[]
  characterHolders CharacterLicense[]

  @@unique([guildId, key])
  @@index([guildId])
}

model LicenseQuestion {
  id           String   @id @default(cuid())
  licenseId    String
  license      License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  question     String
  choices      Json // string[], 2-4 entries
  correctIndex Int
  createdAt    DateTime @default(now())
}

model CharacterLicense {
  id          String    @id @default(cuid())
  guildId     String
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  licenseId   String
  license     License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  obtainedAt  DateTime  @default(now())

  @@unique([characterId, licenseId])
  @@index([guildId])
}

// ============================= RP SESSIONS =============================

model RPSession {
  id                  String    @id @default(cuid())
  guildId             String
  guild               Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  startedByDiscordId  String

  @@index([guildId])
  @@index([guildId, endedAt])
}

// ============================= ROBBERY =============================

model RobberyTarget {
  id               String  @id @default(cuid())
  guildId          String
  guild            Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key              String
  name             String
  rewardMinCents   Int
  rewardMaxCents   Int
  cooldownMinutes  Int     @default(60)
  minPoliceOnDuty  Int     @default(0)
  successChancePct Int     @default(50)
  jailMinutes      Int     @default(15)
  placeId          String?

  attempts RobberyAttempt[]

  @@unique([guildId, key])
  @@index([guildId])
}

model RobberyAttempt {
  id          String        @id @default(cuid())
  guildId     String
  targetId    String
  target      RobberyTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  success     Boolean
  rewardCents Int
  createdAt   DateTime      @default(now())

  @@index([characterId, targetId])
}

// ============================= DRUGS =============================

model DrugType {
  id                String  @id @default(cuid())
  guildId           String
  guild             Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key               String
  name              String
  linkedItemId      String
  linkedItem        Item    @relation(fields: [linkedItemId], references: [id], onDelete: Restrict)
  productionPlaceId String?
  sellPlaceId       String?
  cooldownMinutes   Int     @default(20)
  sellPriceMinCents Int
  sellPriceMaxCents Int
  arrestChancePct   Int     @default(10)
  arrestJailMinutes Int     @default(20)

  productionAttempts DrugProductionAttempt[]

  @@unique([guildId, key])
  @@index([guildId])
}

model DrugProductionAttempt {
  id          String   @id @default(cuid())
  guildId     String
  drugTypeId  String
  drugType    DrugType @relation(fields: [drugTypeId], references: [id], onDelete: Cascade)
  characterId String
  createdAt   DateTime @default(now())

  @@index([characterId, drugTypeId])
}

// ============================= RACKET & LAUNDERING =============================

model RacketCollection {
  id          String   @id @default(cuid())
  guildId     String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([companyId])
}

model LaunderingOperation {
  id          String   @id @default(cuid())
  guildId     String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  grossCents  Int
  feeCents    Int
  netCents    Int
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([companyId])
}

// ============================= STOCK MARKET =============================

model CompanyShare {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)

  @@unique([companyId, characterId])
}

model SharePriceHistory {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceCents Int
  recordedAt DateTime @default(now())

  @@index([companyId, recordedAt])
}

// ============================= SECURITY / MODERATION =============================

model SecurityStaff {
  id            String            @id @default(cuid())
  guildId       String
  discordUserId String
  tier          SecurityStaffTier
  addedByDiscordId String
  addedAt       DateTime          @default(now())

  @@unique([guildId, discordUserId])
  @@index([guildId])
}

enum SecurityStaffTier {
  EXTRA_OWNER
  TRUSTED_ADMIN
}

/**
 * One active rescue secret per guild. Only its bcrypt hash is stored — the
 * raw secret is shown once (in the reply + its QR encoding) at generation
 * time and never persisted. Redeeming sets redeemedAt/redeemedBy instead of
 * deleting the row, so there's a record of past redemptions; generating a
 * new key overwrites the row (guildId is unique — only one live key at a time).
 */
model RescueKey {
  id         String    @id @default(cuid())
  guildId    String    @unique
  hash       String
  generatedByDiscordId String
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
  redeemedByDiscordId String?
}

/**
 * Generalizes GuildConfig's old auditLogChannelId/moderationLogChannelId
 * columns into per-category routing. Those two columns are kept (unused
 * going forward) rather than dropped — additive-only, same as every prior
 * migration — and their existing values are backfilled into LogRoute rows
 * by this migration's SQL so configured channels keep working with zero
 * manual reconfiguration.
 */
model LogRoute {
  id        String      @id @default(cuid())
  guildId   String
  category  LogCategory
  channelId String

  @@unique([guildId, category])
  @@index([guildId])
}

enum LogCategory {
  GENERAL
  MODERATION
  APPEALS
  AUTOMOD
  ANTI_NUKE
  VERIFICATION
  JOIN_GATE
  JOIN_RAID
  PANIC
}

/**
 * Isolation state — survives a bot restart, unlike relying on role
 * membership alone, because we need priorRoleIds to restore on release.
 * One row per currently-or-ever-quarantined member (releasedAt null =
 * still active); re-quarantining after a release creates a fresh row via
 * upsert-by-discordUserId semantics enforced in the service layer.
 */
model QuarantineRecord {
  id            String    @id @default(cuid())
  guildId       String
  discordUserId String    @unique
  priorRoleIds  Json // string[]
  reason        String?   @db.Text
  quarantinedAt DateTime  @default(now())
  releasedAt    DateTime?

  @@index([guildId])
}

/** Generic incident dossier, reused by join-raid (M25), anti-nuke and panic mode (M29/M30) — `kind` distinguishes them, `details` carries whatever is relevant to that kind. */
model SecurityIncident {
  id              String   @id @default(cuid())
  guildId         String
  actorId         String // for join-raid: the triggering member's id; for anti-nuke: the actor being flagged
  kind            String
  details         Json
  autoQuarantined Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([guildId, createdAt])
}

/**
 * Web-mode verification handoff: the dashboard writes this row once a
 * visitor completes Discord OAuth on /verify/[guildId]; the bot polls for
 * unprocessed rows (same cross-process pattern as M9's audit-log mirror
 * and M10's needs ticker — the dashboard's Next.js process and the bot
 * process share only the database) and grants the verified role.
 */
model VerificationAttempt {
  id            String    @id @default(cuid())
  guildId       String
  discordUserId String
  method        String // "button" | "modal" | "grid_captcha" | "web" | "instant"
  completedAt   DateTime  @default(now())
  processedAt   DateTime?

  @@index([guildId, processedAt])
}

model ModerationCase {
  id              String           @id @default(cuid())
  guildId         String
  targetDiscordId String
  moderatorId     String
  action          ModerationAction
  reason          String?          @db.Text
  points          Int              @default(0) // warn points; 0 for non-warn actions
  durationMinutes Int? // informational: timeout length, ban length (null = permanent/indefinite)
  createdAt       DateTime         @default(now())

  @@index([guildId, targetDiscordId])
  @@index([guildId, createdAt])
}

enum ModerationAction {
  WARN
  TIMEOUT
  UNTIMEOUT
  KICK
  BAN
  UNBAN
  QUARANTINE
  UNQUARANTINE
  LOCK
  UNLOCK
}

// ============================= AUDIT LOG =============================

model AuditLog {
  id                String     @id @default(cuid())
  guildId           String
  guild             Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorType         ActorType
  actorDiscordId    String?
  actorCharacterId  String?
  actorCharacter    Character? @relation("AuditActorCharacter", fields: [actorCharacterId], references: [id])
  action            String
  targetType        String?
  targetId          String?
  metadata          Json       @default("{}")
  mirroredToDiscord Boolean    @default(false)
  createdAt         DateTime   @default(now())

  @@index([guildId, createdAt])
  @@index([guildId, action])
}

enum ActorType {
  DISCORD_USER
  DASHBOARD_USER
  SYSTEM
}
